<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 壁纸屏保层（2026-10-23 K）：必应每日图。默认隐藏；选了壁纸屏保才加载。
         图后面压一层从下往上的黑色渐变，保证白亮图片上时间也看得清。 -->
    <ImageView
        android:id="@+id/dreamPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/dreamScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dream_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingTop="52dp"
        android:paddingBottom="24dp"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#E6FFFFFF"
            android:textSize="120sp"
            android:fontFamily="@font/outfit_extralight"
            android:letterSpacing="-0.04"
            android:shadowColor="#B3000000"
            android:shadowRadius="18"
            android:shadowDx="0"
            android:shadowDy="2"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour=""
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#8CFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
