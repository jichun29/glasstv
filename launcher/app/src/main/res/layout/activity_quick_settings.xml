<?xml version="1.0" encoding="utf-8"?>
<!-- 控制中心（2026-10-23 K：照上游 aerial-tv 改版）：
     右上角弹出的圆角玻璃面板，不放音量/亮度（遥控器自带，K 定）。
     大块时间日期 + 两排入口磁贴 + 底部守护状态 + 版本号。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="44dp"
        android:orientation="vertical"
        android:background="@drawable/cc_panel_bg"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:elevation="16dp">

        <!-- 顶部：时间日期 + 网络状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/ccClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#F5FFFFFF"
                    android:textSize="44sp"
                    android:fontFamily="@font/outfit_extralight"
                    android:letterSpacing="-0.03"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/ccDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_regular"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <!-- 网络状态（右上小字） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ccNetIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/ccNetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="140dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_regular" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第一排：信号源 / 网络 / 系统设置 -->
        <LinearLayout
            android:id="@+id/tiles1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:descendantFocusability="afterDescendants"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- 第二排：桌面设置 / 屏保 / 壁纸 -->
        <LinearLayout
            android:id="@+id/tiles2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- 底部只留版本号（K 2026-10-26：控制面板里的「桌面守护」整行撤掉，不显示这个功能） -->
        <TextView
            android:id="@+id/ccVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_regular" />
    </LinearLayout>
</FrameLayout>
